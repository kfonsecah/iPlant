{
  "expo": {
    "name": "iPlant",
    "slug": "iPlant",
    "owner": "kenexpo777",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iplant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "iPlant necesita acceso a tu cámara para diagnosticar tus plantas.",
        "NSPhotoLibraryUsageDescription": "iPlant necesita acceso a tu galería para que puedas subir fotos de tus plantas.",
        "NSMotionUsageDescription": "iPlant usa los sensores de movimiento para efectos visuales de profundidad.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.kenexpo777.iPlant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kenexpo777.iPlant"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "plantIdApiKey": "YOUR_PLANT_ID_API_KEY_HERE",
      "router": {},
      "eas": {
        "projectId": "357f9e0a-046b-4467-bf30-8b7f85e30e02"
      }
    }
  }
}
